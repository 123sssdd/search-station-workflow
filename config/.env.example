# 复制为 .env 并只在本机填写；.env 不得提交（已在 .gitignore）
# Firecrawl CLI / skills（搜索与抓取首选）
FIRECRAWL_API_KEY=
# todo-management 本地 SQLite 文件路径（Todos 备份）
TODO_DB=
# mcp-searxng 指向本地 SearXNG
SEARXNG_URL=http://127.0.0.1:8888
# SearXNG settings.yml 的 server.secret_key（自行生成随机值，例如 openssl rand -hex 16）
SEARXNG_SECRET=
# RSSHub 本地地址（非密钥）
RSSHUB_URL=http://127.0.0.1:1200
