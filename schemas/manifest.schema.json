{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/123sssdd/search-station-workflow/schemas/manifest.schema.json",
  "title": "Sketchmind manifest.json",
  "type": "object",
  "required": [
    "version",
    "updatedAt",
    "items"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp, prefer Asia/Shanghai offset"
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "topic"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "date": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "picked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "description": "Must be an absolute http(s) URL that can be verified with a real request"
          },
          "type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "quality": {
            "type": "number"
          },
          "relevance": {
            "type": "number"
          },
          "score": {
            "type": "number"
          },
          "round": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "applied": {
            "type": "boolean"
          },
          "effect": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content_hash": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
